# Copy to .env.hostinger on the VPS. Never commit the real file.
# Keep the Odoo/MCP, mail, ETS, and OpenAI credentials in the server-side file only.
HOST=0.0.0.0
APP_USER=admin
APP_PASSWORD=replace-with-a-strong-password
VIEWER_USER=viewer
VIEWER_PASSWORD=configure-a-different-private-password
# Production Compose mounts the separate full-runtime backup directory here.
FULL_BACKUP_DIR=/backups
# Set to 1 only when email alerts are intentionally disabled.
# MAIL_DISABLED=1
# Optional Odoo 18 HTTPS API data path (read-only application methods).
# ODOO_DATA_SOURCE=api
# ODOO_API_URL=https://your-odoo.example
# ODOO_DB=your-database
# ODOO_LOGIN=your-integration-user
# ODOO_API_KEY=configure-privately-on-the-server
# DB_SSL_CA is set by docker-compose.hostinger.yml to /app/rds-ca.pem.
