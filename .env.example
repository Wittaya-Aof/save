# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง — ห้าม commit .env ลง git
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=readonly-user
DB_PASS=secret
# 127.0.0.1 = เข้าได้เฉพาะเครื่องนี้ / 0.0.0.0 = เปิดให้เครือข่าย
# ⚠️ ถ้าตั้ง HOST เป็นค่าอื่นที่ไม่ใช่ loopback ต้องตั้ง APP_PASSWORD ด้วย ไม่งั้น server จะปฏิเสธการ start
HOST=127.0.0.1
# path ไปยัง AWS RDS CA bundle เพื่อ verify TLS cert ของฐานข้อมูล (กัน MITM) — แนะนำใน production
# ดาวน์โหลด: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# ถ้าไม่ตั้ง จะเชื่อมแบบเข้ารหัสแต่ไม่ verify cert (มี warning ตอน start)
#DB_SSL_CA=
# ── การเข้าใช้งาน (Basic Auth) — เลือกทางใดทางหนึ่ง ──────────────────────────────────────
# แนะนำ: **บัญชีรายคน** ไม่ต้องตั้งอะไรตรงนี้ ใช้คำสั่งนี้สร้างบัญชีแทน (พิมพ์รหัสผ่านสดในเทอร์มินัล)
#     node manage-users.mjs add <ชื่อผู้ใช้>
# ข้อมูลเก็บที่ users.json (gitignored, เก็บ scrypt hash ไม่เก็บรหัสผ่าน) · server อ่านใหม่เองไม่ต้องรีสตาร์ท
# ข้อดีที่ APP_PASSWORD ทำไม่ได้: ถอนสิทธิ์รายคนได้ · ชื่อใน audit log เป็นชื่อที่ **พิสูจน์แล้ว**
#
# ทางเก่า: รหัสผ่านเดียวใช้ร่วมกันทุกคน (ยังใช้ได้เมื่อยังไม่มีบัญชีรายคนสักคน)
#APP_PASSWORD=
# พอมีบัญชีรายคนแล้ว รหัสร่วมด้านบนจะ **ใช้ไม่ได้ทันที** — ตั้งเป็น 1 ถ้ายังอยากให้ใช้ได้ระหว่างย้าย
# ⚠ เปิดไว้ = การแก้ที่เข้ามาทางรหัสร่วมจะบันทึกชื่อตามที่ client พิมพ์มา ซึ่งพิสูจน์ไม่ได้
#ALLOW_SHARED_PASSWORD=1
# scan-shipment-docs.mjs โหมด AI — มีค่าใช้จ่ายจริงต่อโฟลเดอร์ที่สแกน (ไม่ตั้ง = ใช้โหมดฟรี regex อัตโนมัติ)
#OPENAI_API_KEY=
# เปลี่ยนโมเดลได้ถ้าต้องการ (default: gpt-5.4-mini) — ต้องเป็นโมเดลที่อ่าน PDF/รูปได้
#VERIFY_MODEL=
# lib/verify-shipment.js (ตัวตรวจเอกสารเวอร์ชัน AI ที่ยังไม่ได้ผูกเข้า api-server.js) ใช้ OPENAI_API_KEY ตัวเดียวกัน
# ── เรตราคา AI ต่อ 1 ล้าน token (ดอลลาร์) — ดูค่าจริงที่ platform.openai.com/pricing ──
# ไม่ตั้ง = `node scan-shipment-docs.mjs --usage` รายงานเฉพาะจำนวน token (ซึ่งวัดได้จริงเสมอ)
# ตั้งแล้ว = คำนวณเป็นดอลลาร์ให้ด้วย และถ้าใส่ USD_THB ด้วยก็แปลงเป็นบาทให้
# *อย่าเดาค่า* — เรตผิดแล้วรายงานเป็นบาทคือตัวเลขที่ไม่มีที่มา ยังไงยอดจริงอยู่ที่ platform.openai.com/usage
#OPENAI_PRICE_IN=
#OPENAI_PRICE_CACHED_IN=
#OPENAI_PRICE_OUT=
#USD_THB=
# บัญชี e-tracking.customs.go.th (กรมศุลกากร) — ใช้ดึง ETA (Actual Arrival Date) ใน scan-shipment-docs.mjs
#ETS_USER=
#ETS_PASS=
# ── อีเมลแจ้งเตือน (integrity check เจอข้อมูลผิดปกติ) — ว่างไว้ = ปิดการแจ้งเตือน ไม่ error ──
# ผู้รับแจ้งเตือน (ใส่หลายคนได้ คั่นด้วย ,)
#ALERT_EMAIL_TO=
#
# ── ทางที่ 1 (แนะนำสำหรับบัญชี Microsoft 365 ขององค์กร): Microsoft Graph API ──
# ใช้เมื่อองค์กรเปิด "Security Defaults" ซึ่งบล็อกการล็อกอิน SMTP ด้วยรหัสผ่านทั้ง tenant
# (อาการ: 535 5.7.139 "user is locked by your organization's security defaults policy")
# ต้องให้แอดมิน Azure/M365 ทำครั้งเดียว — ดูขั้นตอนใน docs/graph-mail-setup.md
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
# mailbox ที่จะใช้เป็นผู้ส่ง (ต้องมีอยู่จริงใน tenant)
#MAIL_FROM=
#
# ── ทางที่ 2: SMTP ธรรมดา (Gmail App password หรือ SMTP server อื่น) ──
# ไม่ตั้ง MAIL_HOST = smtp.office365.com:587 STARTTLS
#MAIL_USER=
#MAIL_PASS=
#MAIL_HOST=
#MAIL_PORT=
# Gmail เดิมยังใช้ได้ (ต้องเป็น App password ไม่ใช่รหัสผ่านบัญชี)
#GMAIL_USER=
#GMAIL_APP_PASSWORD=
